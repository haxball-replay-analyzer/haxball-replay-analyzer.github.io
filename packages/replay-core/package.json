{
  "name": "@hbra/replay-core",
  "version": "0.1.0",
  "private": true,
  "description": "Dekoder powtórek HaxBall (.hbr2) i statystyki bez przeglądarki (HBRA)",
  "type": "module",
  "exports": {
    ".": "./src/index.js",
    "./haxball": "./src/haxball.js"
  },
  "dependencies": {
    "pako": "^1.0.11"
  },
  "eslintConfig": {
    "root": true,
    "parserOptions": {
      "ecmaVersion": 2022,
      "sourceType": "module"
    },
    "env": {
      "es2022": true
    },
    "globals": {
      "performance": "readonly",
      "console": "readonly"
    },
    "rules": {
      "no-undef": "error"
    }
  }
}
